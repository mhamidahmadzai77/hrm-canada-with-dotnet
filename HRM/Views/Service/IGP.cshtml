    <script>
        function adjustElementStyle() {
            var width = window.innerWidth;
            var element = document.getElementById('successStoryImage');

            if (width < 480) {
                element.style.marginTop = "15px"; // For widths < 480px
            } else if (width < 992) {
                element.style.marginTop = "15px"; // For widths < 992px but >= 480px
            } else {
                element.style.marginTop = "150px"; // For widths >= 992px
            }
        }

        window.addEventListener('resize', adjustElementStyle);
        window.addEventListener('load', adjustElementStyle);
    </script>

