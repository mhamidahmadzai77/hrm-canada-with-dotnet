    <script>

        var currentAmounts = [240, 970, 140]; // for outer donation
        var currentInnerAmounts = [240, 970, 140]; // for inner donation (footer)

        // Header Donation
        var donationType = "one off";


        document.getElementById('amount-2').style.backgroundColor = "#fff";
        document.getElementById('amount-2').style.color = "#000";
        document.getElementById('amount').value = '970';

        function amountClicked(amount) {
            var selectedAmount = 0;
            if (amount == "1") {
                selectedAmount = currentAmounts[0];
            }
            else if (amount == "2") {
                selectedAmount = currentAmounts[1];
            }
            else if (amount == "3") {
                selectedAmount = currentAmounts[2];
            }

            $('#amount').val(selectedAmount);

            var amountButtons = document.getElementsByClassName('btn-amount');
            for (var i = 0; i < amountButtons.length; i++) {
                amountButtons[i].style.backgroundColor = '#660199';
                amountButtons[i].style.color = '#fff';
            }

            if (selectedAmount == currentAmounts[0]) {
                document.getElementById("amount-1").style.backgroundColor = "#fff";
                document.getElementById("amount-1").style.color = "#000";
            }
            if (selectedAmount == currentAmounts[1]) {
                document.getElementById("amount-2").style.backgroundColor = "#fff";
                document.getElementById("amount-2").style.color = "#000";
            }
            if (selectedAmount == currentAmounts[2]) {
                document.getElementById("amount-3").style.backgroundColor = "#fff";
                document.getElementById("amount-3").style.color = "#000";
            }
        }


        function changeColorWithMouseOver(num) {
            var element = document.getElementById('amount-' + num);
            element.style.backgroundColor = '#fff'; // Highlight on hover
            element.style.color = '#000';
        }

        function changeColorWithMouseOut(num) {
            var amountValue = document.getElementById('amount').value;
            var buttonElement = document.getElementById('amount-' + num);

            // Get the button text without HTML tags and extract the number
            var buttonText = buttonElement.innerText.replace(/\s+/g, ' ').trim();
            var match = buttonText.match(/£(\d+)/);

            if (match) {
                var buttonAmount = match[1];
                if (amountValue != buttonAmount) {
                    buttonElement.style.backgroundColor = '#660199'; // Default color if not selected
                    buttonElement.style.color = '#fff';
                }
            }
        }



        function checkInputValue() {
            const input = document.getElementById('amount-4');
            if (input.value == "" || Number(input.value) <= 0) {
                const qty = document.getElementById('quantity-button');
                qty.classList.add('shake');
                // Remove the class after animation ends so it can shake again next time
                setTimeout(() => qty.classList.remove('shake'), 500);
            }
        }

        function checkInnerInputValue() {
            const input = document.getElementById('inner-amount-4');
            if (input.value == "" || Number(input.value) <= 0) {
                const innerQty = document.getElementById('inner-quantity-button');
                innerQty.classList.add('shake');
                // Remove the class after animation ends so it can shake again next time
                setTimeout(() => innerQty.classList.remove('shake'), 500);
            }
        }

        function donateNow(project_name) {
            checkInputValue();
            const input = document.getElementById('amount-4');
            if (input.value !== "" && Number(input.value) > 0) {
                project_name = document.getElementById("country_list").value // Get selected country dynamically


                var value = 0;

                value = parseInt(document.getElementById('amount').value);
                var qty = parseInt(document.getElementById('amount-4').value);
                value = value * qty;

                if (!isNaN(value) && value > 0) {
                    if (project_name == "Afghanistan") {
                        project_name = "Afghanistan-Qurbani"
                        addAndRefreshBasket(41, project_name, value);
                    }
                    else if (project_name == "Bangladesh") {
                        project_name = "Bangladesh-Qurbani"
                        addAndRefreshBasket(42, project_name, value);
                    }
                    else if (project_name == "Pakistan") {
                        project_name = "Pakistan-Qurbani"
                        addAndRefreshBasket(43, project_name, value);
                    }
                    else if (project_name == "Gaza") {
                        project_name = "Gaza-Qurbani"
                        addAndRefreshBasket(44, project_name, value);
                    }
                    else if (project_name == "India") {
                        project_name = "India-Qurbani"
                        addAndRefreshBasket(45, project_name, value);
                    }
                    else if (project_name == "Nigeria") {
                        project_name = "Nigeria-Qurbani"
                        addAndRefreshBasket(46, project_name, value);
                    }
                    showToast("Thank you!", "Your donation of $[" + value + "] has been added to the basket.", "success");
                }
            }
            
        }
        function donateEidGiftNow(project_name) {
            var value = 20;
            addAndRefreshBasket(47, project_name, value);
            showToast("Thank you!", "Your donation of $[" + value + "] has been added to the basket.", "success");

        }



        // Footer Donation
        var donationType = "one off";


        document.getElementById('inner-amount-2').style.backgroundColor = "#fff";
        document.getElementById('inner-amount-2').style.color = "#000";
        document.getElementById('inner-amount').value = '970';

        function innerAmountClicked(amount) {


            var selectedAmount = 0;
            if (amount == "1") {
                selectedAmount = currentInnerAmounts[0];
            }
            else if (amount == "2") {
                selectedAmount = currentInnerAmounts[1];
            }
            else if (amount == "3") {
                selectedAmount = currentInnerAmounts[2];
            }

            $('#inner-amount').val(selectedAmount);

            var amountButtons = document.getElementsByClassName('inner-btn-amount');
            for (var i = 0; i < amountButtons.length; i++) {
                amountButtons[i].style.backgroundColor = '#660199';
                amountButtons[i].style.color = '#fff';
            }

            if (selectedAmount == currentInnerAmounts[0]) {
                document.getElementById("inner-amount-1").style.backgroundColor = "#fff";
                document.getElementById("inner-amount-1").style.color = "#000";
            }
            if (selectedAmount == currentInnerAmounts[1]) {
                document.getElementById("inner-amount-2").style.backgroundColor = "#fff";
                document.getElementById("inner-amount-2").style.color = "#000";
            }
            if (selectedAmount == currentInnerAmounts[2]) {
                document.getElementById("inner-amount-3").style.backgroundColor = "#fff";
                document.getElementById("inner-amount-3").style.color = "#000";
            }
        }
        function innerChangeColorWithMouseOver(num) {
            var element = document.getElementById('inner-amount-' + num);
            element.style.backgroundColor = '#fff'; // Highlight on hover
            element.style.color = '#000';
        }

        function innerChangeColorWithMouseOut(num) {
            var amountValue = document.getElementById('inner-amount').value;
            var buttonElement = document.getElementById('inner-amount-' + num);

            // Get button text and extract the number
            var buttonText = buttonElement.innerText.replace(/\s+/g, ' ').trim();
            var match = buttonText.match(/£(\d+)/);

            if (match) {
                var buttonAmount = match[1];
                if (amountValue != buttonAmount) {
                    buttonElement.style.backgroundColor = '#660199'; // Reset color if not selected
                    buttonElement.style.color = '#fff';
                }
            }
        }


       
        function innerDonateNow(project_name) {
            checkInnerInputValue();
            const input = document.getElementById('inner-amount-4');
            if (input.value !== "" && Number(input.value) > 0) {
                var project_name = document.getElementById("inner-country_list").value // Get selected country dynamically

                var value = 0;

                value = parseInt(document.getElementById('inner-amount').value);
                var innerQty = parseInt(document.getElementById('inner-amount-4').value);
                value = value * innerQty;
                if (!isNaN(value) && value > 0) {
                    if (project_name == "Afghanistan") {
                        project_name = "Afghanistan-Qurbani"
                        addAndRefreshBasket(41, project_name, value);
                    }
                    else if (project_name == "Bangladesh") {
                        project_name = "Bangladesh-Qurbani"
                        addAndRefreshBasket(42, project_name, value);
                    }
                    else if (project_name == "Pakistan") {
                        project_name = "Pakistan-Qurbani"
                        addAndRefreshBasket(43, project_name, value);
                    }
                    else if (project_name == "Gaza") {
                        project_name = "Gaza-Qurbani"
                        addAndRefreshBasket(44, project_name, value);
                    }
                    else if (project_name == "India") {
                        project_name = "India-Qurbani"
                        addAndRefreshBasket(45, project_name, value);
                    }
                    else if (project_name == "Nigeria") {
                        project_name = "Nigeria-Qurbani"
                        addAndRefreshBasket(46, project_name, value);
                    }
                    showToast("Thank you!", "Your donation of $[" + value + "] has been added to the basket.", "success");
                }
            }
            
        }


        function updateButtonAmounts() {
            var country = document.getElementById("country_list").value;
            amountClicked(2);

            var amounts = {
                "Afghanistan": [240, 970, 140],
                "Bangladesh": [180, 450, 66],
                "Pakistan": [160, 490, 70],
                "Gaza": [0, 5600, 0],
                "India": [160, 190, 28],
                "Nigeria": [288, 1520, 218]
            };

            currentAmounts = amounts[country] || [240, 970, 140];

            if (country == "Gaza") {
                document.getElementById("amount-1").style.display = 'none';
                document.getElementById("amount-2").innerHTML = 'Small <br />$' + currentAmounts[1];
                document.getElementById("amount-2").style.padding = '6px 10px';
                document.getElementById("amount-3").style.display = 'none';

            } else {
                document.getElementById("amount-1").style.display = 'inline';
                document.getElementById("amount-3").style.display = 'inline';
                document.getElementById("amount-2").style.padding = '6px 10px';

                document.getElementById("amount-1").innerHTML = 'Small <br />$' + currentAmounts[0];
                document.getElementById("amount-2").innerHTML = 'Large <br />$' + currentAmounts[1];
                document.getElementById("amount-3").innerHTML = '1/7<sup>th</sup> Share <br />$' + currentAmounts[2];
            }
            amountClicked(2);
        }


