    <script>
        function adjustElementStyle() {
            var width = window.innerWidth;
            var element = document.getElementById('successStoryImage');

            if (width < 480) {
                element.style.marginTop = "15px"; // For widths < 480px
            } else if (width < 992) {
                element.style.marginTop = "15px"; // For widths < 992px but >= 480px
            } else {
                element.style.marginTop = "150px"; // For widths >= 992px
            }
        }

        window.addEventListener('resize', adjustElementStyle);
        window.addEventListener('load', adjustElementStyle);
    </script>
    <script>
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach(item => {
            item.addEventListener('click', () => {
                const answer = item.querySelector('.faq-answer');
                const expandIcon = item.querySelector('.expand-icon');

                if (answer.style.display === 'none' || answer.style.display === '') {
                    answer.style.display = 'block';
                    expandIcon.classList.add('open');
                } else {
                    answer.style.display = 'none';
                    expandIcon.classList.remove('open');
                }
            });
        });
    </script>
