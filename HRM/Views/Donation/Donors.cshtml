@model IEnumerable<HRM.Models.Donor>
@{

    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Donor Management | Human Relief Mission Canada";
    ViewBag.Description = "Admin access only: Manage and review donor information and contributions for Human Relief Mission Canada. Access detailed records and oversee donor engagement and support.";
    ViewBag.Keywords = "donor management, admin access, donor records, contribution tracking, Human Relief Mission Canada, data management, admin tools";
    ViewBag.OGandTwitterTitle = "Donor Management | Human Relief Mission Canada";


}

<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <link href="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.css" rel="stylesheet" type="text/css" />
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL STYLES -->
    <link href="~/assets/global/css/components-rounded.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link href="~/assets/global/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <!-- END THEME GLOBAL STYLES -->
    <!-- BEGIN THEME LAYOUT STYLES -->
    <link href="~/assets/layouts/layout/css/layout.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/layouts/layout/css/themes/darkblue.min.css" rel="stylesheet" type="text/css" id="style_color" />
    <link href="~/assets/Home/custom.css" rel="stylesheet" />


    <style>
        .purple {
            background-color: #660199;
        }

        /* Hide error messages by default */
        span.error {
            color: red;
            font-size: 12px;
            display: none;
        }


        #view-pocily {
            display: block;
        }
    </style>
</head>
<body>



    <div class="container-fluid" style="margin-top:120px;">

        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box default">
                <div class="portlet-title">
                    <div class="caption">
                        <b><i class="icon-settings"></i> Donors </b>
                    </div>
                </div>
                <div class="portlet-body">

                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> No </th>
                                <th> Donor Name </th>
                                <th> Email </th>
                                <th> Amount </th>
                                <th> Project </th>
                                <th> Donation Type </th>
                                <th> Phone </th>
                                <th> Address </th>
                                <th> City </th>
                                <th> Country </th>
                                <th> Tax Payer </th>
                                <th> Customer ID </th>
                                <th> Created At </th>
                                <th> Remarks </th>
                            </tr>
                        </thead>
                        <tbody class="table-with-action" style="color:#000;">
                            @{
                                int number = 0;

                            }

                            @if (Model != null)
                            {
                                foreach (var donor in Model)
                                {
                                    number++;
                                    <tr>
                                        <td> @number </td>
                                        <td> @donor.donor_firstname @donor.donor_surname </td>
                                        <td> @donor.email </td>
                                        <td> @donor.amount </td>
                                        <td> @donor.project_name </td>
                                        <td> @donor.donation_type </td>
                                        <td> @donor.phone </td>
                                        <td> @donor.address </td>
                                        <td> @donor.city </td>
                                        <td> @donor.country </td>
                                        <td> @donor.taxpayer </td>
                                        <td> @donor.customerID </td>
                                        <td> @donor.createdAt </td>
                                        <td> @donor.remarks</td>
                                    </tr>
                                }

                            }


                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END EXAMPLE TABLE PORTLET-->
        </div>
    </div>

    <script src="~/assets/global/plugins/jquery.min.js" type="text/javascript"></script>

    <!-- BEGIN THEME GLOBAL SCRIPTS -->
    <script src="~/assets/global/scripts/app.min.js" type="text/javascript"></script>
    <!-- END THEME GLOBAL SCRIPTS -->


</body>
</html>
