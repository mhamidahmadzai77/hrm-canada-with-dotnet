    <script>
        // PayPal Payment
function submitPayment() {
    const formData = new FormData(document.getElementById('submit_form'));
    const data = {};
    formData.forEach((value, key) => {
        data[key] = value;
    });
    const queryString = new URLSearchParams(data).toString();
    window.location.href = "https://humanreliefmission.com/Paypal/PaymentWithPaypal?" + queryString;
}

// Google Pay Setup
function onGooglePayLoaded() {
    const paymentsClient = new google.pay.api.PaymentsClient({ environment: 'PRODUCTION' });
    const button = paymentsClient.createButton({
        buttonColor: 'default',
        buttonType: 'long',
        onClick: onGooglePayButtonClicked
    });
    document.getElementById('google-pay-button').appendChild(button);
}

function onGooglePayButtonClicked(event) {
    event.preventDefault();
    const form = document.getElementById('submit_form');
    const formData = new FormData(form);
    const amount = formData.get('amount');

    const paymentDataRequest = {
        apiVersion: 2,
        apiVersionMinor: 0,
        merchantInfo: {
            merchantId: 'BCR2DN4T2P45JTIZ',
            merchantName: 'Human Relief Mission'
        },
        transactionInfo: {
            totalPriceStatus: 'FINAL',
            totalPrice: String(amount), // Amount from the form
            currencyCode: 'CAD',
            countryCode: 'CA'
        },
    };

    const paymentsClient = new google.pay.api.PaymentsClient({ environment: 'PRODUCTION' });
    paymentsClient.loadPaymentData(paymentDataRequest)
        .then(paymentData => {
            if (paymentData.paymentMethodData && paymentData.paymentMethodData.tokenizationData) {
                $.ajax({
                    url: '@Url.Action("ProcessPaymentWithGooglePay", "GooglePay")',
                    type: 'POST',
                    data: JSON.stringify({
                        PaymentMethodData: paymentData.paymentMethodData.tokenizationData.token,
                        TotalPrice: String(amount),
                        CurrencyCode: paymentData.transactionInfo.currencyCode,
                        donor: {
                            donation_type: formData.get('donation_type'),
                            project_name: formData.get('project_name'),
                            amount: formData.get('amount'),
                            donor_firstname: formData.get('donor_firstname'),
                            donor_surname: formData.get('donor_surname'),
                            email: formData.get('email'),
                            phone: formData.get('phone'),
                            address: formData.get('address'),
                            city: formData.get('city'),
                            country: formData.get('country'),
                            taxpayer: formData.get('taxpayer'),
                            remarks: formData.get('remarks')
                        }
                    }),
                    contentType: 'application/json',
                    success: response => {
                        if (response.redirectTo) {
                            window.location.href = response.redirectTo;
                        }
                    },
                    error: (xhr, status, error) => console.error('Payment error:', xhr.responseText || error)
                });
            } else {
                console.error('Payment method data is missing or incorrect.');
            }
        })
        .catch(err => console.error('Error loading payment data:', err));
}

// Apple Pay Setup
@*document.addEventListener("DOMContentLoaded", function () {
    if (window.ApplePaySession && ApplePaySession.canMakePayments()) {
        document.getElementById('apple-pay-button').style.display = 'block';
        document.getElementById('apple-pay-button').addEventListener('click', () => startApplePaySession(false));
    }
});

function startApplePaySession(isSubscription) {
    const paymentRequest = {
        countryCode: 'CA',
        currencyCode: 'CAD',
        total: {
            label: 'Human Relief Mission',
            amount: '1.00'
        },
        supportedNetworks: ['visa', 'masterCard', 'amex'],
        merchantCapabilities: ['supports3DS']
    };

    const session = new ApplePaySession(3, paymentRequest);

    session.onvalidatemerchant = async event => {
        const validationData = await fetch('@Url.Action("ApplePayMerchantValidation", "ApplePay")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ validationUrl: event.validationURL })
        }).then(response => response.json());
        session.completeMerchantValidation(validationData);
    };

    session.onpaymentauthorized = async event => {
        const paymentMethod = {
            token: event.payment.token.paymentData,
            type: isSubscription ? 'subscription' : 'one-time'
        };

        const stripeResponse = await fetch('@Url.Action("ProcessPaymentWithApplePay", "ApplePay")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(paymentMethod)
        }).then(response => response.json());

        if (stripeResponse.success) {
            session.completePayment(ApplePaySession.STATUS_SUCCESS);
        } else {
            session.completePayment(ApplePaySession.STATUS_FAILURE);
        }
    };

    session.begin();
}
