@model HRM.Models.Donation

@using HRM.Models
@using Newtonsoft.Json;

@{

    Layout = "~/Views/Shared/paymentLayout.cshtml";

    ViewBag.Title = "Donate Now | Human Relief Mission Canada";
    ViewBag.Description = "Make a difference today with your donation to Human Relief Mission Canada. Support our vital projects, including food aid, healthcare, and education, and help us provide essential relief to those in need.";
    ViewBag.Keywords = "donate, charitable donation, donate today, humanitarian aid, support our mission, food relief, healthcare support, education funding, Human Relief Mission Canada";
    ViewBag.OGandTwitterTitle = "Donate to Human Relief Mission Canada - Make an Impact";

}

