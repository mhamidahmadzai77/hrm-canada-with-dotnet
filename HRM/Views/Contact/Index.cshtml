                    <input type="text" class="form-control" id="contactFirstname" oninput="validateFirstname()" placeholder="Firstname">
                    <span class="error" id="firstname-error">Firstname must be between 3 and 30 characters</span>
                </div>
                <div class="form-group col-md-3">
                    <label for="contactLastname">Lastname <span style="color:red;font-size:14px;font-weight:normal">(Required)</span></label>
