@{
    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/_EndUserLayout.cshtml";
    }

    ViewBag.Title = "Contact Us | Human Relief Mission Canada";
    ViewBag.Description = "Get in touch with Human Relief Mission Canada. Whether you have questions, need support, or want to learn more about our mission, we’re here to help. Reach out to us through our contact form or details provided.";
    ViewBag.Keywords = "contact us, get in touch, support, inquiries, Human Relief Mission Canada, contact information";
    ViewBag.OGandTwitterTitle = "Contact Human Relief Mission Canada";


}

