@using HRM.Models;
@{
    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/_EndUserLayout.cshtml";
    }

    string searchedQuery = Request.QueryString["s"];

    ViewBag.Title = "Search Results | Human Relief Mission Canada";
    ViewBag.Description = "Explore the results from Human Relief Mission Canada. Find information about our hunger relief programs, food aid initiatives, and how you can get involved in supporting those in need.";
    ViewBag.Keywords = "search results, hunger relief programs, food aid, charitable initiatives, humanitarian support, Human Relief Mission Canada";
    ViewBag.OGandTwitterTitle = "Search Results | Human Relief Mission Canada";


}

<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>


    <link href="~/assets/Home/custom.css" rel="stylesheet" />
    <link href="~/assets/search/search.css" rel="stylesheet" />
    <style type="text/css">
    </style>
</head>
<body style="margin: 0; padding: 0;">



    <div class="search-box-container">
        <h1 class="search-title">Search results for `@searchedQuery`</h1>
        <div class="search-container">
            <form action="/Search/Index" method="get">
                <input type="text" id="search" name="s" placeholder="" class="search-box-in-page" value="@searchedQuery">
                <button class="search-button">Search <i class="fa fa-arrow-right"></i></button>
            </form>
        </div>
        <div class="results">
            <p class="result-count">@ViewBag.numberOfResult result</p>
            @if (ViewBag.numberOfResult == 0)
            {
                <p class="no-results" id="no-results">No results found</p>
            }
        </div>
    </div>

    @* BEGIN Section appeals*@
    @if (ViewBag.searchedAppeals != null && ((List<Appeal>)ViewBag.searchedAppeals).Any())
    {
        <div class="container-fluid" style="margin-top:30px;">
            <div class="">
                <div class="col-md-12 ">
                    <div class="portlet light portlet-fit ">
                        <div class="portlet-body ">
                            <div class="row events-caption" style="padding:30px;">
                                <h2 style="font-weight: bold;">Appeals</h2>
                            </div>
                            <div class="mt-element-card mt-element-overlay">
                                <div class="row">

                                    @foreach (Appeal appeal in (List<Appeal>)ViewBag.searchedAppeals)
                                    {
                                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 ">
                                            <div class="mt-card-item upcomming-event">
                                                <div class="mt-card-avatar mt-overlay-1">
                                                    <a href="/Appeals/Appeal?id=@appeal.appeal_id&emergency_appeal=@appeal.title">
                                                        <div class="new-project-label">
                                                            Appeal
                                                        </div>
                                                        <img src="@Url.Action("DisplayHeaderImage", "Appeals", new { id = appeal.appeal_id })" style="position: relative; z-index: 0;" />
                                                    </a>
                                                </div>
                                                <div class="mt-card-content">
                                                    <p class="mt-card-desc font-grey-mint"><i class="fa fa-calendar"></i> @appeal.publication_date.ToShortDateString()</p>
                                                    <a href="/Appeals/Appeal?id=@appeal.appeal_id&emergency_appeal=@appeal.title">
                                                        <h3 class="mt-card-name" style="font-size:1.4em;padding:8px;color:black;min-height:70px;">
                                                            @appeal.title
                                                        </h3>
                                                    </a>
                                                    <div class="mt-card-social">
                                                        <ul>
                                                            <li>
                                                                <a href="javascript:;" class="btn btn-outline bold" style="color: #fff;background-color:red;">
                                                                    Donate Now
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    @* END Section appeals*@


    @* BEGIN PROJECTS*@
