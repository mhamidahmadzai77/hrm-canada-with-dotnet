        Layout = "~/Views/Shared/_EndUserLayout.cshtml";
    }

    ViewBag.Title = "Our Projects - Services | Human Relief Mission Canada";
    ViewBag.Description = "Explore the diverse projects and services offered by Human Relief Mission Canada. From food packages and hot meals to building masjids, providing ambulances, and supporting education and healthcare, learn how we’re making a difference in communities around the world.";
