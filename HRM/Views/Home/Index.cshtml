@model IEnumerable<HRM.Models.Appeal>
@using HRM.Models
@{
    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        Layout = "~/Views/Shared/_EndUserLayout.cshtml";
    }

    ViewBag.Title = "Human Relief Mission Canada - Fighting Global Hunger";
    ViewBag.Description = "Welcome to Human Relief Mission Canada. Discover our mission to tackle global hunger through food aid, community support, and humanitarian efforts. Learn how you can make a difference today.";
    ViewBag.Keywords = "humanitarian aid, global hunger relief, food security, charity organization, community support, Human Relief Mission Canada, food assistance";
    ViewBag.OGandTwitterTitle = "Human Relief Mission Canada - Join Us in Fighting Hunger";


}

<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>

    <link href="~/assets/Home/custom.css" rel="stylesheet" />

    <style type="text/css">
        .image-container {
            position: relative; /* Allows absolute positioning of images */
            overflow: hidden; /* Ensures overflow is hidden to create the sliding effect */
            width: 100%; /* Set width for the image container */
            cursor: pointer;
        }

        .slideshow-image {
            position: absolute; /* Position images absolutely within the container */
            width: 100%; /* Make sure images occupy full width */
            height: auto; /* Maintain aspect ratio */
            transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out; /* Transition for sliding and fading */
        }

        .slideshow-displayed-image {
            opacity: 1; /* Initially fully visible */
            position: relative; /* Initial position for the first image */
        }

        /* Fade out */
        .fade-out {
            opacity: 0; /* Fully transparent during fade-out */
        }

        /* Slide to the left */
        .slide-left {
            transform: translateX(-100%); /* Slide left */
        }

        /* Slide in from the right */
        .slide-right {
            transform: translateX(100%); /* Slide right */
        }

        .quote {
            font-size: 2em;
        }
    </style>
</head>
<body style="margin: 0; padding: 0;">

    <div>
        @if (ViewBag.SlideShow != null && ((List<SlideShow>)ViewBag.SlideShow).Any())
        {
            int imageNo = 0;
            foreach (SlideShow slideShow in (List<SlideShow>)ViewBag.SlideShow)
            {
                imageNo++;
                <img class="image slideshow-image" src='@slideShow.imagePath' data-appeal-url='@slideShow.url' id="@imageNo" style="display:none" />

            }
        }

    </div>

    <div class="container-fluid slider" style="margin:0;padding:0;">
        <a class="carousel-control-prev text-decoration-none w-auto ps-3" href="javascript:;" role="button" data-bs-slide="prev" id="prevBtn">
            <i class="fa fa-chevron-left"></i>
        </a>
        <a class="carousel-control-next text-decoration-none w-auto pe-3" href="javascript:;" role="button" data-bs-slide="next" id="nextBtn">
            <i class="fa fa-chevron-right"></i>
        </a>
        <div class="image-container" onclick='goToAppeal("")'>
            <img class="image slideshow-displayed-image" src="" alt="Emergency Appeal" />
            <div class="image-slogan">
                <br />
                <button class="btn btn-danger" onclick='goToAppeal("")'> Donate Now </button>
            </div>
        </div>
    </div>



    @* Start Section Qoute*@
    <div class="container-fluid">
        <div class="" style="margin-top:50px;margin-bottom:50px;">
            <div class="col-md-1"></div>
            <div class="quote-container col-md-10">
                <span class="" style="font-size:4em;font-weight:bold">&lsquo;&lsquo;</span>
                <p class="quote">He is not a believer who fills his stomach while his neighbour goes hungry.</p>
                <p class="source">Hadith | Bukhari</p>
            </div>

            <div class="col-md-1"></div>
        </div>

    </div>
    @* End Section Qoute*@

    @* BEGIN ACTIVITIES*@
    <div class="container-fluid " style="background-color: #f8f8f8 ">
        <div class="live-saving-header">
            <h1 style="font-weight:bold;padding-bottom:30px;">Activities</h1>
        </div>
        <div class="row container-support-lifesaving">

            <a href="/About_Us/Our_Work" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color" style="background-color: #660199;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/pic/our-work/Empowering Afghan Seniors (3).jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card" >
                                        <h5 class="card-title bold" style="font-size:1.5em;color: #fff;">Community Work</h5>
                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;color: #fff;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
        </div>
        
    </div>
    @* END ACTIVITIES*@

    @* Start Section appeals*@
    <div class="container-fluid" style="margin-top:80px;">

        <div class="">
            <div class="col-md-12 ">
                <div class="portlet light portlet-fit ">
                    <div class="portlet-body ">
                        <div class="row events-caption" style="padding:30px;">
                            <h2 style="font-weight: bold;">Appeals</h2>
                        </div>
                        <div class="mt-element-card mt-element-overlay">
                            <div class="row">
                                @foreach (var appeal in Model)
                                {
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12 ">
                                        <div class="mt-card-item upcomming-event">

                                            <div class="mt-card-avatar mt-overlay-1">
                                                <a href="/Appeals/Appeal?id=@appeal.appeal_id&emergency_appeal=@appeal.title">
                                                    <div class="new-project-label">
                                                        Appeal
                                                    </div>
                                                    <img src="@appeal.header_picture_path" style="position: relative; z-index: 0;" />
                                                </a>
                                            </div>
                                            <div class="mt-card-content">
                                                <p class="mt-card-desc font-grey-mint"><i class="fa fa-calendar"></i> @appeal.publication_date.ToShortDateString()</p>
                                                <a href="/Appeals/Appeal?id=@appeal.appeal_id&emergency_appeal=@appeal.title">
                                                    <h3 class="mt-card-name" style="font-size:1.4em;padding:8px;color:black;min-height:70px;">
                                                        @appeal.title
                                                    </h3>
                                                </a>
                                                <div class="mt-card-social">
                                                    <ul>
                                                        <li>
                                                            <a href="/Appeals/Appeal?id=@appeal.appeal_id&emergency_appeal=@appeal.title" class="btn  btn-outline bold" style="color: #fff;background-color:red;">
                                                                Read more
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="row text-center">
                                <a href="/Appeals/Index" class="btn purple btn-outline see-more-link " style="padding:10px;background-color:#660199;color:#fff;">See more appeals <i class="fa fa-long-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* END Section appeals*@


    @* BEGIN PROJECTS *@
    <div class="container-fluid " style="background-color: #f8f8f8 ">
        <div class="live-saving-header">
            <h1 style="font-weight:bold;padding-bottom:30px;">Projects</h1>
        </div>
        <div class="row container-support-lifesaving">

            <a href="/Service/FoodSecurity" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/food-security/food package 2.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Food Security</h5>
                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
            <a href="/Service/WaterAid" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/water-aid/Watar Aid 5.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Water Aid</h5>

                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
            <a href="/Service/Health" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/health-services/Health Services 4.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Health Services</h5>

                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
            <a href="/Service/BuildingMasjid" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/construction/HRM-building-masjid 2.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Construction Projects</h5>

                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
            <a href="/Service/SponsorshipProgramme" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/sponsorship-programme/sponsorship-programme.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Sponsorship programme</h5>

                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
            <a href="/Service/Ambulance" style="color:#000;">
                <div class="col-12 col-md-6 col-lg-4 support-lifesaving-card animated-element" onmouseenter="addAnimation(this)" onmouseleave="removeAnimation(this)">
                    <!-- Card 1 -->
                    <div class="card mb-3 card-color">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <img src="~/Content/projects/ambulance-services/human-relief-mission-ambulance 1.jpg" class="image-support-live" alt="Responsive image">
                                    <div class="mt-3 yellow-card">
                                        <h5 class="card-title bold" style="font-size:1.5em;">Emergency Ambulance Services</h5>

                                        <i class="fa fa-arrow-right pull-right " style="padding-bottom:10px;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">

                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="row text-center">
            <a href="/Home/Services" class="btn purple btn-outline see-more-link " style="padding:10px;background-color:#660199;color:#fff;">See more services <i class="fa fa-long-arrow-right"></i></a>
        </div>
    </div>
    @* END PROJECTS *@

    <script src="~/assets/Home/custom.js"></script>
</body>
</html>