@model IEnumerable<HRM.Models.User>
@{

    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Create User Account | Human Relief Mission Canada";
    ViewBag.Description = "Admin interface for creating new user accounts.";
    ViewBag.Keywords = "create user account, admin panel, human relief mission Canada, nonprofit organization";
    ViewBag.OGandTwitterTitle = "Create User Account | Human Relief Mission Canada";

}
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>


    <link href="~/assets/sweetalert.css" rel="stylesheet" />
</head>
<body>


    <div class="row">
        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box green">
                <div class="portlet-title">
                    <div class="caption">
                        <i class="icon-settings"></i> Users
                    </div>
                    <div class="tools"> </div>
                </div>
                <div class="portlet-body">
                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> No </th>
                                <th> Username </th>
                                <th> Email </th>
                                <th> عمل </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int number = 1;

                                foreach (var col in Model)
                                {
                                    <tr id="@col.user_id">
                                        @*BEGIN COL 1*@
                                        <td> @number </td>
                                        @*END COL 1*@

                                        @*BEGIN COL 2*@
                                        <td> @col.username </td>
                                        @*END COL 2*@

                                        @*BEGIN COL 3*@
                                        <td> @col.email </td>
                                        @*END COL 3*@

                                        @*BEGIN COL 4*@
                                        <td>

                                            <button type="button" onclick="DeleteConfirmation(@col.user_id)" class="btn red mt-ladda-btn ladda-button btn-outline" data-style="slide-down" data-spinner-color="#800">
                                                <span class="ladda-label">
                                                    <i class="fa fa-trash-o"></i> Delete
                                                </span>
                                                <span class="ladda-spinner"></span>
                                            </button>

                                        </td>
                                        @*END COL 4*@


                                    </tr>
                                    number++;
                                }
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END EXAMPLE TABLE PORTLET-->
        </div>
    </div>
    <script src="~/assets/alert.js"></script>
    <script src="~/assets/userview-delete-stript.js"></script>
</body>
</html>
@{

    if (Session["changed"] != null)
    {


        if (Session["changed"].ToString() == "true")
        {
            // If any record was updated than set the session to false and show an alert
            Session["changed"] = "false";
            <script type="text/javascript">
                swal("تغیرات", "په بریالیتوب سره مو حساب تغیر کړ", {
                    icon: "success", buttons: "سمه ده"
                });
            </script>
        }
    }
}
