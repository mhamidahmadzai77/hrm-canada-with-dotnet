<body class="login">
    <p>&nbsp;</p>
    <!-- BEGIN CONFIRM PASSWORD -->
    <div class="content">

        <form class="" method="post" id="confirmPasswordForm">

            <h3 class="bold">Confirm your password</h3>
            <p>We sent you new password, Check your email inbox</p>
            <div class="alert alert-danger display-hide" id="emptyAlert" role="alert">
                <button class="close" id="closeAlert" data-close="alert"></button>
                <span>Password must be 6 digits</span>
            </div>
            <div class="form-group">
                <div class="input-icon">
                    <i class="fa fa-lock"></i>
                    <input class="form-control placeholder-no-fix" type="password" autocomplete="off" placeholder="Password" name="password" id="password" />
                </div>
            </div>
            <div class="form-action">
                <br />
                <button type="submit" class="btn purple pull-right" id="btnSubmitPassword" style="border:1px solid #999;"> Send </button>
                <br />
            </div>
        </form>

    </div>
