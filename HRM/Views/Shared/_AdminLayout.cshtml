    <script>
        function toggleSearchBar() {
            const searchBarId = "top-search-bar";
            const searchBarExists = document.getElementById(searchBarId);
            const beforeElement = document.getElementById("before-top-search-bar");
            var searchIcon = document.getElementById('search-icon');

            if (window.innerWidth < 992) {
                if (searchBarExists) {
                    searchBarExists.remove(); // Remove the search bar if it exists
                    searchIcon.className = "icon-magnifier"; // Change icon
                }
            } else {
                // If search bar does not exist, create it
                if (!searchBarExists) {
                    const searchBar = document.createElement("div");
                    searchBar.className = "overlay";
                    searchBar.id = searchBarId;

                    searchBar.innerHTML = `
                                            <form action="/Search/Index" method="get">
                                                <input type="text" class="search-box" id="search" name="s" placeholder="Start Typing...">
                                                <button class="search-button">Search <i class="fa fa-arrow-right"></i></button>
                                            </form>
                                        `;

                    // Insert the search bar after <p id="before-top-search-bar"></p>
                    beforeElement.insertAdjacentElement("afterend", searchBar);
                } else {
                    searchBarExists.style.display = "block"; // Show the search bar if it already exists
                }
            }
        }

        // Initial check on page load
        window.onload = toggleSearchBar;

        // Check on window resize
        window.onresize = toggleSearchBar;
    </script>

