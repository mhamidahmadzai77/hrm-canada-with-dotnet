    <script type="text/javascript">
        function changeIconColor(color) {
            const element = document.getElementById("basket-item-list");

            // Get the computed style of the element
            const displayValue = window.getComputedStyle(element).display;

            if (color == "#fff") {

                if (displayValue == "none") {
                    document.getElementById('basket-icon').style.color = "#fff";
                }
                else if (displayValue == "block") {
                    document.getElementById('basket-icon').style.color = "gray";
                }
            }
            else {
                document.getElementById('basket-icon').style.color = "gray";
            }

            adjustElementStyle();
        }

        // Function to call when clicking outside the basket-container element
        function ClickedOutSideOfBasketArea() {
            document.getElementById('basket-icon').style.color = "#fff";
            adjustElementStyle();
        }
        // Select the <li> element
        const basketContainerElement = document.getElementById("basket-container");

        // Add an event listener to the document
        document.addEventListener("click", function (event) {
            // Check if the clicked element is not the <li> or any of its descendants
            if (!basketContainerElement.contains(event.target)) {
                ClickedOutSideOfBasketArea();
            }
        });

        const myIcon = document.getElementById("myIcon");


        myIcon.addEventListener("mouseover", () => {
            myIcon.style.filter = "grayscale(0)";
        });

        myIcon.addEventListener("mouseout", () => {
            myIcon.style.filter = "grayscale(1)";
        });


        // Change basket color if page loaded in mobile device 
        function adjustElementStyle() {
            var width = window.innerWidth;
            var element = document.getElementById('basket-icon');

            if (width <= 480) {
                document.getElementById('basket-icon').style.color = "gray";
            } else {
                document.getElementById('basket-icon').style.color = "#fff";
            }
        }

        window.addEventListener('resize', adjustElementStyle);
        window.addEventListener('load', adjustElementStyle);
        adjustElementStyle();

    </script>

  
