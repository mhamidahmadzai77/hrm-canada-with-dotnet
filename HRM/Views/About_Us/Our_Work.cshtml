        ViewBag.Title = "Our Work | Human Relief Mission Canada";
        ViewBag.Description = "Explore the local community work of Human Relief Mission Canada, including our 2025 senior empowerment project, community engagement initiatives, and support programs for newcomers in Ottawa.";
        ViewBag.Keywords = "our work, community work, HRM Canada projects, senior empowerment, newcomer support, Ottawa community programs, Human Relief Mission Canada";
