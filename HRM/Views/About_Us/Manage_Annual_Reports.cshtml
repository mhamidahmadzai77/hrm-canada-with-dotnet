@model IEnumerable<HRM.Models.Annual_Report>
@{

    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Manage Annual Report | Human Relief Mission Canada";
    ViewBag.Description = "Admin access only: Manage and update the Annual Report for Human Relief Mission Canada. Oversee report content, make revisions, and ensure accurate presentation of our yearly achievements and financials.";
    ViewBag.Keywords = "manage annual report, update report, admin access, report management, Human Relief Mission Canada, financial reporting, annual review";
    ViewBag.OGandTwitterTitle = "Manage Annual Report | Human Relief Mission Canada";


}
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <link href="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.css" rel="stylesheet" type="text/css" />
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL STYLES -->
    <link href="~/assets/global/css/components-rounded.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link href="~/assets/global/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <!-- END THEME GLOBAL STYLES -->
    <!-- BEGIN THEME LAYOUT STYLES -->
    <link href="~/assets/layouts/layout/css/layout.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/layouts/layout/css/themes/darkblue.min.css" rel="stylesheet" type="text/css" id="style_color" />
    <link href="~/assets/Home/custom.css" rel="stylesheet" />


    <style>
        .purple {
            background-color: #660199;
        }

        .add-new {
            background-color: #e1e5ec;
            color: #666666;
            margin-right: 185px;
            margin-top: -5px;
            margin-bottom: -5px;
        }

            .add-new:hover {
                background-color: #c2cad8;
            }

        /* Hide error messages by default */
        span.error {
            color: red;
            font-size: 12px;
            display: none;
        }

        #add-report {
            display: none;
        }

        #view-report {
            display: block;
        }

        tbody tr:last-child {
            height: 140px; /* Reset height for the last row */
        }

        .error-message {
            display: none;
        }

        #image-error {
            display: none;
        }
    </style>
</head>
<body>

    <div id="add-report" style="background-color: #faf9f9; min-height: 300px;padding:30px;margin-top:50px;text-align:justify;padding-top:50px;padding-bottom:80px;font-size:16px;">

        <form>
            <div class="row">
                <div class="row" style="margin:40px 0;">
                    <div class="col-md-3"></div>
                    <div class="col-md-6" style="text-align:center;">
                        <h2 style="font-weight:bold">Add New Annual Report</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3"></div>
                <div class="form-group col-md-6">
                    <label for="year" style="font-size:16px;">Select Year <span style="color: red;">*</span></label>
                    <select class="form-control" id="year" oninput="validateYear()">
                        <option value="2010">2010</option>
                        <option value="2011">2011</option>
                        <option value="2012">2012</option>
                        <option value="2013">2013</option>
                        <option value="2014">2014</option>
                        <option value="2015">2015</option>
                        <option value="2016">2016</option>
                        <option value="2017">2017</option>
                        <option value="2018">2018</option>
                        <option value="2019">2019</option>
                        <option value="2020">2020</option>
                        <option value="2021">2021</option>
                        <option value="2022">2022</option>
                        <option value="2023">2023</option>
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>
                        <option value="2026">2026</option>
                        <option value="2027">2027</option>
                        <option value="2028">2028</option>
                        <option value="2029">2029</option>
                        <option value="2030">2030</option>
                        <option value="2031">2031</option>
                        <option value="2032">2032</option>
                        <option value="2033">2033</option>
                        <option value="2034">2034</option>
                        <option value="2035">2035</option>
                        <option value="2036">2036</option>
                        <option value="2037">2037</option>
                        <option value="2038">2038</option>
                        <option value="2039">2039</option>
                        <option value="2040">2040</option>
                        <option value="2041">2041</option>
                        <option value="2042">2042</option>
                        <option value="2043">2043</option>
                        <option value="2044">2044</option>
                        <option value="2045">2045</option>
                        <option value="2046">2046</option>
                        <option value="2047">2047</option>
                        <option value="2048">2048</option>
                        <option value="2049">2049</option>
                        <option value="2050">2050</option>
                    </select>

                    <span class="error" id="year-error">Year is required</span>
                </div>
                <div class="col-md-3"></div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <label for="file" style="display:block;">Select Report File <span style="color: red;">*</span></label>
                        <div class="fileinput fileinput-new" data-provides="fileinput">
                            <div class="input-group input-large">
                                <div class="form-control uneditable-input input-fixed input-large" data-trigger="fileinput">
                                    <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                    <span class="fileinput-filename"></span>
                                </div>
                                <span class="input-group-addon btn default btn-file">
                                    <span class="fileinput-new"> Select file </span>
                                    <span class="fileinput-exists"> Change </span>
                                    <input type="hidden" value="" name="...">
                                    <input type="file" id="file" name="" accept=".pdf" oninput="isSelected()"> <!-- Only accept PDF files -->
                                </span>
                                <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                            </div>
                        </div><br />
                        <span class="error" id="file-error">file is required</span>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    <div class=" form-group-item margin-top-30 margin-bottom-30">Select Cover picture <span style="color: red;">*</span></div>
                    <div class="form-group form-group-item">
                        <div class="fileinput fileinput-new" data-provides="fileinput">
                            <div class="fileinput-new thumbnail" style="width: 200px; height: 150px;">
                                <img src="http://www.placehold.it/200x150/EFEFEF/AAAAAA&amp;text=no+image" alt="">
                            </div>
                            <div class="fileinput-preview fileinput-exists thumbnail" style="max-width: 200px; max-height: 150px;"></div>
                            <div>
                                <span class="error-message" id="image-error" style="font-size:12px;color: red;">This is required</span>
                                <span class="btn default btn-file">
                                    <span class="fileinput-new">Select Picture</span>
                                    <span class="fileinput-exists"> Change </span>
                                    <input type="file" onchange="validateImage()" name="..." id="imageFile">
                                </span>

                                <a href="javascript:;" class="btn default fileinput-exists" data-dismiss="fileinput"> Remove </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-md-3"></div>
            <div class="form-check col-md-6">
                <p></p>
                <button type="button" onclick="sendData()" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;margin-left:-7px;"> Save </button>
                <button type="button" onclick="displayReportList()" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;margin-left:0px;"> Go to list </button>
            </div>
            <div class="col-md-3"></div>

        </form>

    </div>


    <div id="view-report" class="container-fluid" style="margin-top:120px;">

        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box default">
                <div class="portlet-title">
                    <div class="caption">
                        <b><i class="icon-settings"></i> Annual Reports </b>
                    </div>
                    <div class="tools"><button onclick="diplayInsertionForm()" class="btn default pull-right add-new" style="">Add new</button> </div>


                </div>
                <div class="portlet-body">

                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> No </th>
                                <th> Report's Year </th>
                                <th style="width:150px;"> Actions </th>
                            </tr>
                        </thead>
                        <tbody class="table-with-action">
                            @{
                                int number = 0;
                            }

                            @foreach (var report in Model)
                            {
                                number++;
                                var yearId = "yearId" + report.annual_report_id;
                                <tr id="@report.annual_report_id">
                                    <td>@number</td>
                                    <td id="@yearId">@report.year</td>
                                    <td>
                                        <div class="btn-group">
                                            <button class="btn btn-xs purple dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false">
                                                Actions
                                                <i class="fa fa-angle-down"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-manage" role="menu">
                                                <li>
                                                    <a href="/About_Us/Update_Annual_Report/@report.annual_report_id">
                                                        <i class="fa fa-edit"></i> Update
                                                    </a>
                                                </li>
                                                <li onclick="deleteReport(@report.annual_report_id)">
                                                    <a href="javascript:;">
                                                        <i class="icon-trash"></i> Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END EXAMPLE TABLE PORTLET-->
        </div>
    </div>

    <script src="~/assets/global/plugins/jquery.min.js" type="text/javascript"></script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <script src="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.js" type="text/javascript"></script>
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL SCRIPTS -->
    <script src="~/assets/global/scripts/app.min.js" type="text/javascript"></script>
    <!-- END THEME GLOBAL SCRIPTS -->

    <script src="~/assets/about/annual-reports.js"></script>
    <script src="~/assets/alert.js"></script>
    <script>


    </script>

</body>
</html>

@if (Session["reportUpdated"] != null)
{
    if (Session["reportUpdated"].ToString() == "true")
    {
        <script>
            showToast("Updated Successfully", "", "success");
        </script>
        Session["reportUpdated"] = "";
    }


}