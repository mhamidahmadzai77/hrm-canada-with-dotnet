                    </a>
                    <a href="javascript:;" class="footer-social-link" title="Copy to clipboard">
                        <div class="classic-menu-dropdown" onclick="copyCurrentURL()" style="width: 22px; height: 22px; border-radius: 4px; text-align: center; float: left; margin-left: 33px; margin-top: 0px; ">
                            <img src="~/assets/custom-image/copy.png" width="32" />
