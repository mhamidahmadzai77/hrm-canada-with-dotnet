@model HRM.Models.Policy
@{

    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Update Policy | Human Relief Mission Canada";
    ViewBag.Description = "Admin access only: Update and revise organizational policies for Human Relief Mission Canada. Ensure that all policy documents are current, accurate, and compliant with regulatory standards.";
    ViewBag.Keywords = "update policy, policy revisions, admin access, policy management, Human Relief Mission Canada, policy updates, compliance";
    ViewBag.OGandTwitterTitle = "Update Policy | Human Relief Mission Canada";


}
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <link href="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.css" rel="stylesheet" type="text/css" />
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL STYLES -->
    <link href="~/assets/global/css/components-rounded.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link href="~/assets/global/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <!-- END THEME GLOBAL STYLES -->
    <!-- BEGIN THEME LAYOUT STYLES -->
    <link href="~/assets/layouts/layout/css/layout.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/layouts/layout/css/themes/darkblue.min.css" rel="stylesheet" type="text/css" id="style_color" />
    <link href="~/assets/Home/custom.css" rel="stylesheet" />


    <style>
        .purple {
            background-color: #660199;
        }

        .add-new {
            background-color: #e1e5ec;
            color: #666666;
            margin-right: 185px;
            margin-top: -5px;
            margin-bottom: -5px;
        }

            .add-new:hover {
                background-color: #c2cad8;
            }

        /* Hide error messages by default */
        span.error {
            color: red;
            font-size: 12px;
            display: none;
        }

        #add-report, #edit-report {
            display: none;
        }

        #view-report {
            display: block;
        }
    </style>
</head>
<body>


    <div style="background-color: #faf9f9; min-height: 300px;padding:30px;font-size:18px;margin-top:50px;text-align:justify;padding-top:50px;padding-bottom:80px;font-size:22px;">

        <form>
            <div class="row">
                <div class="row" style="margin:40px 0;">
                    <div class="col-md-3"></div>
                    <div class="col-md-6" style="text-align:center;">
                        <h2 style="font-weight:bold;text-align:center;">Edit Annual Report</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <input type="hidden" id="id" name="name" value="@Model.policy_id" />
                <div class="col-md-3"></div>
                <div class="form-group col-md-6">
                    <label for="editPolicyName">Policy Name <span style="color: red;">*</span></label>
                    <input type="text" class="form-control" oninput="validateEditedPolicyName()" id="edit-policy-name" name="editPolicyName" value="@Model.policy_name" />
                    <span class="error" id="edit-policy-error">Policy Name must be at least 3 characters.</span>
                </div>
                <div class="col-md-3"></div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <label for="file">Select a file</label>
                        <div class="fileinput fileinput-new" data-provides="fileinput">
                            <div class="input-group input-large">
                                <div class="form-control uneditable-input input-fixed input-large" data-trigger="fileinput">
                                    <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                    <span class="fileinput-filename"></span>
                                </div>
                                <span class="input-group-addon btn default btn-file">
                                    <span class="fileinput-new"> Select file </span>
                                    <span class="fileinput-exists"> Change </span>
                                    <input type="hidden" value="" name="...">
                                    <input type="file" id="edit-file" name="" accept=".pdf" oninput="isSelected()"> <!-- Only accept PDF files -->
                                </span>
                                <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                            </div>
                        </div><br />
                    </div>

                </div>
            </div>
            <div class="col-md-3"></div>
            <div class="form-check col-md-6">
                <p></p>
                <button type="button" onclick="sendUpdatedData()" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;margin-left:-7px;"> Update </button>
                <a href="/About_Us/Manage_Policies" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;"> Cancel </a>
            </div>
            <div class="col-md-3"></div>

        </form>

        <script>

            document.getElementById("policyName").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();  // Prevent form submission
                }
            });
        </script>
    </div>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <script src="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.js" type="text/javascript"></script>
    <!-- END PAGE LEVEL PLUGINS -->
    <script src="~/assets/about/policy-edition.js"></script>
    <script src="~/assets/alert.js"></script>
    <script>

    </script>

</body>
</html>
