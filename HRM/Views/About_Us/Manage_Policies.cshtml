@model IEnumerable<HRM.Models.Policy>
@{

    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Manage Policies | Human Relief Mission Canada";
    ViewBag.Description = "Admin access only: Manage and update organizational policies for Human Relief Mission Canada. Oversee policy revisions, ensure compliance, and maintain accurate policy documentation.";
    ViewBag.Keywords = "manage policies, policy updates, admin access, organizational policies, Human Relief Mission Canada, policy management, compliance";
    ViewBag.OGandTwitterTitle = "Manage Policies | Human Relief Mission Canada";


}

<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RXXJLDEKC3"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', 'G-RXXJLDEKC3');
    </script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <link href="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.css" rel="stylesheet" type="text/css" />
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL STYLES -->
    <link href="~/assets/global/css/components-rounded.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link href="~/assets/global/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <!-- END THEME GLOBAL STYLES -->
    <!-- BEGIN THEME LAYOUT STYLES -->
    <link href="~/assets/layouts/layout/css/layout.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/layouts/layout/css/themes/darkblue.min.css" rel="stylesheet" type="text/css" id="style_color" />
    <link href="~/assets/Home/custom.css" rel="stylesheet" />


    <style>
        .purple {
            background-color: #660199;
        }

        .add-new {
            background-color: #e1e5ec;
            color: #666666;
            margin-right: 185px;
            margin-top: -5px;
            margin-bottom: -5px;
        }

            .add-new:hover {
                background-color: #c2cad8;
            }

        /* Hide error messages by default */
        span.error {
            color: red;
            font-size: 12px;
            display: none;
        }

        #add-policy {
            display: none;
        }

        #view-pocily {
            display: block;
        }

        tbody tr:last-child {
            height: 140px; /* Reset height for the last row */
        }
    </style>
</head>
<body>

    <div id="add-policy" style="background-color: #faf9f9; min-height: 300px;padding:30px;font-size:18px;margin-top:50px;text-align:justify;padding-top:50px;padding-bottom:80px;font-size:22px;">
        <form method="post">
            <div class="row">
                <div class="row" style="margin:40px 0;">
                    <div class="col-md-3"></div>
                    <div class="col-md-6" style="text-align:center;">
                        <h2 style="font-weight:bold">Add New Policy</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3"></div>
                <div class="form-group col-md-6">
                    <label for="policyName">Policy Name <span style="color: red;">*</span></label>
                    <input type="text" class="form-control" oninput="validatePolicyName()" name="policyName" id="policyName" value="" />
                    <span class="error" id="policy-error">Policy Name must be at lease 3 characters.</span>
                </div>
                <div class="col-md-3"></div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <label for="file" style="display:block;">Select a file <span style="color: red;">*</span></label>
                        <div class="fileinput fileinput-new" data-provides="fileinput">
                            <div class="input-group input-large">
                                <div class="form-control uneditable-input input-fixed input-large" data-trigger="fileinput">
                                    <i class="fa fa-file fileinput-exists"></i>&nbsp;
                                    <span class="fileinput-filename"></span>
                                </div>
                                <span class="input-group-addon btn default btn-file">
                                    <span class="fileinput-new"> Select file </span>
                                    <span class="fileinput-exists"> Change </span>
                                    <input type="hidden" value="" name="...">
                                    <input type="file" id="file" name="" accept=".pdf" oninput="isSelected()"> <!-- Only accept PDF files -->
                                </span>
                                <a href="javascript:;" class="input-group-addon btn red fileinput-exists" data-dismiss="fileinput"> Remove </a>
                            </div>
                        </div><br />
                        <span class="error" id="file-error">file is required</span>
                    </div>

                </div>
            </div>
            <div class="col-md-3"></div>
            <div class="form-check col-md-6">
                <p></p>
                <button type="button" onclick="sendData()" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;margin-left:-7px;"> Save </button>
                <button type="button" onclick="displayPoliciesList()" class="btn purple" style="background-color:#660199;color:#fff;width:130px;font-weight:bold;margin-left:0px;"> Go to list </button>
            </div>
            <div class="col-md-3"></div>

        </form>
        <script>

            document.getElementById("policyName").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();  // Prevent form submission
                }
            });
        </script>
    </div>


    <div id="view-policy" class="container-fluid" style="margin-top:120px;">

        <div class="col-md-12">
            <!-- BEGIN EXAMPLE TABLE PORTLET-->
            <div class="portlet box default">
                <div class="portlet-title">
                    <div class="caption">
                        <b><i class="icon-settings"></i> HRM Policies </b>
                    </div>
                    <div class="tools"><button onclick="diplayInsertionForm()" class="btn default pull-right add-new" style="">Add new</button> </div>


                </div>
                <div class="portlet-body">

                    <table class="table table-striped table-bordered table-hover" id="sample_2">
                        <thead>
                            <tr>
                                <th> No </th>
                                <th> Policy Name </th>
                                <th> Pages </th>
                                <th> FileType </th>
                                <th> FileSize </th>
                                <th style="width:150px;"> Actions </th>
                            </tr>
                        </thead>
                        <tbody class="table-with-action">
                            @{
                                int number = 0;

                            }

                            @foreach (var policy in Model)
                            {
                                number++;
                                var policyNameId = "policyName" + policy.policy_id;
                                var fileTypeId = "fileType" + policy.policy_id;
                                var fileSizeId = "fileSize" + policy.policy_id;

                                <tr id="@policy.policy_id">
                                    <td>@number</td>
                                    <td id="@policyNameId">@policy.policy_name</td>
                                    <td>@policy.pages</td>
                                    <td id="@fileTypeId">@policy.file_type</td>
                                    <td id="@fileSizeId">@policy.file_size</td>
                                    <td>
                                        <div class="btn-group">
                                            <button class="btn btn-xs purple dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false">
                                                Actions
                                                <i class="fa fa-angle-down"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-manage" role="menu">
                                                <li>
                                                    <a href="/About_Us/Update_Policy/@policy.policy_id">
                                                        <i class="fa fa-edit"></i> Update
                                                    </a>
                                                </li>
                                                <li onclick="deletePolicy(@policy.policy_id)">
                                                    <a href="javascript:;">
                                                        <i class="icon-trash"></i> Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END EXAMPLE TABLE PORTLET-->
        </div>
    </div>

    <script src="~/assets/global/plugins/jquery.min.js" type="text/javascript"></script>

    <!-- BEGIN PAGE LEVEL PLUGINS -->
    <script src="~/assets/global/plugins/bootstrap-fileinput/bootstrap-fileinput.js" type="text/javascript"></script>
    <!-- END PAGE LEVEL PLUGINS -->
    <!-- BEGIN THEME GLOBAL SCRIPTS -->
    <script src="~/assets/global/scripts/app.min.js" type="text/javascript"></script>
    <!-- END THEME GLOBAL SCRIPTS -->

    <script src="~/assets/about/policy.js"></script>
    <script src="~/assets/alert.js"></script>
    <script>


    </script>

</body>
</html>

@if (Session["policyUpdated"] != null)
{
    if (Session["policyUpdated"].ToString() == "true")
    {
        <script>
            showToast("Updated Successfully", "", "success");
        </script>
        Session["policyUpdated"] = "";
    }


}