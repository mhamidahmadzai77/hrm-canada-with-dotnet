@model HRM.Models.Appeal
@{
    if (Session["user_108310113658"] != null)
    {
        if (Session["user_108310113658"].ToString() == "authenticated")
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
    }
    else
    {
        <script>
            window.location.href = "/Home/Index";
        </script>
    }

    ViewBag.Title = "Update Appeal | Human Relief Mission Canada";
    ViewBag.Description = "Admin access only: Update the details of existing appeals for Human Relief Mission Canada. Modify campaign information, adjust goals, and track changes to ensure effective fundraising and support.";
    ViewBag.Keywords = "update appeal, modify campaign, admin access, appeal management, Human Relief Mission Canada, fundraising updates";
    ViewBag.OGandTwitterTitle = "Update Appeal | Human Relief Mission Canada";


}

